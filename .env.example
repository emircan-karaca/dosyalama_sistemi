# Uygulama anahtarları (kurulumda arayüzden girilen PG/SMB bilgileri burada DEĞİL)
ENCRYPTION_KEY=change-me-to-a-long-random-secret-key!!
SECRET_KEY=change-me-to-another-long-random-secret-key!!

# Frontend -> Backend (Docker içi)
BACKEND_URL=http://backend:8000

# CORS
CORS_ORIGINS=http://localhost:50,http://127.0.0.1:50

# CIFS mount (opsiyonel — STORAGE_MODE=mount veya admin panelden)
STORAGE_MODE=smb
SMB_MOUNT_ENABLED=false
SMB_MOUNT_HOST=
SMB_MOUNT_SHARE=
SMB_MOUNT_USERNAME=
SMB_MOUNT_PASSWORD=
